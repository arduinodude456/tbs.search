us, dass es kein Unfall war. Das Opfer Jan Witt war investigativer Journalist und bekannt dafür, auf der 'Kehrseite der Menschlichkeit' zu recherchieren. Welchem Verbrechen war er auf der Spur? Mit Cordelia Wege, David Bredin, Franz Dinda, Thilo Prothmann, Knut Berger u.a. | Buch: Holger Karsten Schmidt | Regie: Esther Rauch","updated":"2026-09-05T18:30:31Z"},"216737065918819":{"url":"https://accounts.google.com/v3/signin/identifier?continue=https%3A%2F%2Fmyaccount.google.com%2Fgeneral-light&followup=https%3A%2F%2Fmyaccount.google.com%2Fgeneral-light&osid=1&passive=1209600&flowName=WebLiteSignIn&flowEntry=ServiceLogin&dsh=S-1239634234%3A1788724545502135","title":"Sign in - Google Accounts","description":"","updated":1788724545},"121014307165539":{"url":"https://de.wikipedia.org/wiki/Code_Postal","title":"Code Postal – Wikipedia","description":"","updated":1789501011},"221431970091875":{"url":"https://auth.wikimedia.org/dewiki/wiki/Spezial:Benutzerkonto_anlegen?useformat=mobile&usesul3=1&returnto=Wikipedia%3AAutorenportal&centralauthLoginToken=86d1825468db341e8b5f21e81b43e4e0","title":"Benutzerkonto anlegen – Wikipedia","description":"","updated":1789084326},"115798598201443":{"url":"https://auth.wikimedia.org/dewiki/wiki/Spezial:Anmelden?useformat=mobile&usesul3=1&returnto=August+Alsina&centralauthLoginToken=e1e9c7df9953bdc47ef3071b4b476165","title":"Anmelden – Wikipedia","description":"","updated":1789364986},"250850225064803":{"url":"https://de.wikipedia.org/w/index.php?title=Baseball-Bundesliga_%28%C3%96sterreich%29&action=edit&section=5","title":"„Baseball-Bundesliga (Österreich)“ – Bearbeiten – Wikipedia","description":"","updated":1789239691},"11983805312611":{"url":"http://www.osdata.com/traffic.htm","title":"Building Web Traffic","description":"building web traffic","updated":1788728855},"212186387922787":{"url":"https://de.wikipedia.org/wiki/Robert_Bartko","title":"Robert Bartko – Wikipedia","description":"","updated":1789421480},"87215899126627":{"url":"ht